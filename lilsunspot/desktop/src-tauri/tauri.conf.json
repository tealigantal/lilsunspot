{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Lilsunspot",
  "version": "0.1.0",
  "identifier": "com.lilsunspot.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build:tauri",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Lilsunspot 小黑子",
        "width": 960,
        "height": 680,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "externalBin": ["binaries/lilsunspotd"],
    "icon": []
  }
}
